{
  "name": "react-native-size-class",
  "version": "0.1.4",
  "description": "A convenient library to get updates on SizeClass changes on iOS and iPadOS. Temporarily doesn't support Android.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "react-native-size-class.podspec",
    "!lib/typescript/example",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "pods": "cd example && pod-install --quiet",
    "bootstrap": "yarn example && yarn && yarn pods"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/tyfyakov21/react-native-size-class",
  "author": "Nikita Tiufiakov <tyfyakov@gmail.com> (https://github.com/tyfyakov21)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tyfyakov21/react-native-size-class/issues"
  },
  "homepage": "https://github.com/tyfyakov21/react-native-size-class#readme",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@arkweid/lefthook": "^0.7.7",
    "@commitlint/config-conventional": "^17.0.2",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "^0.88.1",
    "@react-native/jest-preset": "^0.88.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "commitlint": "^17.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "pod-install": "^0.1.0",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "release-it": "^21.1.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.82.0"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "^6.2.5"
    },
    "react-native-builder-bob": {
      "glob": "^14.0.2"
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNSizeClassSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.reactnativesizeclass"
    },
    "ios": {
      "componentProvider": {
        "RNSizeClassView": "RNSizeClassView"
      }
    }
  }
}
